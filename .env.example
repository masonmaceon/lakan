# LAKÁN - environment variables
#
# Copy this file to `.env` and fill in the values you have.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real values.

# ---------------------------------------------------------------------------
# Database (MySQL / MariaDB) - REQUIRED for map, routing, admin and memos
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lakan_db

# ---------------------------------------------------------------------------
# Chatbot (DeepSeek) - REQUIRED for the chat assistant
# ---------------------------------------------------------------------------
# Get a key at https://platform.deepseek.com/
# Without this, the chatbot falls back to its built-in rule-based responses
# (campus directions and building info still work; free-form Q&A does not).
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Camera / building detection (Roboflow) - OPTIONAL
# ---------------------------------------------------------------------------
# Camera detection is NOT functional until you supply a key here.
# This is a setup requirement, not a bug. See README.md -> "Camera detection".
# Get a key at https://docs.roboflow.com/api-reference/authentication
ROBOFLOW_API_KEY=

# ---------------------------------------------------------------------------
# Flask - optional
# ---------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=True
